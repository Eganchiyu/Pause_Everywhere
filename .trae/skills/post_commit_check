## 附录：完整检查脚本

```bash
#!/bin/bash
# post-commit-check.sh

echo "====================================="
echo "  Post Commit Check 结果"
echo "====================================="

errors=0
warnings=0

# 1. Gitignore 检查
echo ""
echo "[检查] Gitignore..."
if git diff --cached --name-only | grep -qE '\.(user|tmp|log|pfx)$'; then
  echo "[!] 发现不应提交的文件"
  ((warnings++))
else
  echo "[✓] 通过"
fi

# 2. 风格审查
echo ""
echo "[检查] 风格审查..."
# 添加具体检查逻辑

# 3. 命名方式检查
echo ""
echo "[检查] 命名方式..."
# 添加具体检查逻辑

# 4. README 同步检查
echo ""
echo "[检查] README 同步..."
# 添加具体检查逻辑

# 5. CHANGELOG 同步检查
echo ""
echo "[检查] CHANGELOG 同步..."
# 添加具体检查逻辑

# 6. 文档同步检查
echo ""
echo "[检查] 文档同步..."
# 添加具体检查逻辑

# 输出总结
echo ""
echo "====================================="
echo "  检查完成: $warnings 个警告, $errors 个错误"
echo "====================================="

if [ $errors -gt 0 ]; then
  exit 1
fi
```
